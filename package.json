{
  "name": "activity-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --no-file-parallelism --passWithNoTests",

    "_db:diff:run": "psqldef -U $DATABASE_USER -h $DATABASE_HOST -W $DATABASE_PASSWORD $DATABASE_DB --dry-run < sql/schema.sql",
    "_db:apply:run": "psqldef -U $DATABASE_USER -h $DATABASE_HOST -W $DATABASE_PASSWORD $DATABASE_DB < sql/schema.sql",

    "db:diff": "dotenv -e .env -- pnpm run _db:diff:run",
    "db:apply": "dotenv -e .env -- pnpm run _db:apply:run",
    "db:types": "dotenv -e .env -- pnpm exec pgtyped -c pgtyped.config.json",

    "db:diff:test": "dotenv -e .env.test -- pnpm run _db:diff:run",
    "db:apply:test": "dotenv -e .env.test -- pnpm run _db:apply:run",
    "db:types:test": "dotenv -e .env.test -- pnpm exec pgtyped -c pgtyped.config.json",

    "dry-ci": "act pull_request -P local-ubuntu=-self-hosted --env-file=.env.test",
    "dry-cd": "act -P local-ubuntu=-self-hosted --env-file=.env.test"

  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@juice11-micro/contracts": "^1.0.4",
    "@nestjs/config": "^4.0.3",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@pgtyped/runtime": "^2.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "rxjs": "^7.8.2"

  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@pgtyped/cli": "^2.4.3",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "get-port": "^7.2.0",
    "globals": "^16.0.0",
    "pgtyped": "^0.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"

  }
}
